---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { generateBreadcrumbSchema } from '../utils/seo';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  author: string;
  readTime: string;
  tags: string[];
}

const { title, description, pubDate, author, readTime, tags } = Astro.props;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blog' },
  { name: title, url: Astro.url.pathname },
];

const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbs);
---

<BaseLayout title={`${title} | PDFAfy`} description={description} jsonLd={breadcrumbSchema}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <Breadcrumbs items={breadcrumbs} />
    
    <article class="mt-8">
      <header class="mb-10 pb-8 border-b border-[#ebebeb] dark:border-[#262626]">
        <div class="flex flex-wrap items-center gap-2 mb-4">
          {tags.map((tag) => (
            <span class="px-2.5 py-0.5 text-xs font-medium rounded-full bg-[#fafafa] dark:bg-[#171717] border border-[#ebebeb] dark:border-[#262626] text-[#4d4d4d] dark:text-[#a3a3a3]">
              {tag}
            </span>
          ))}
        </div>
        
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-semibold tracking-tight text-[#171717] dark:text-[#f5f5f5] leading-[1.15] mb-6">
          {title}
        </h1>

        <p class="text-lg text-[#4d4d4d] dark:text-[#a3a3a3] leading-relaxed mb-6">
          {description}
        </p>

        <div class="flex items-center gap-4 text-xs sm:text-sm text-[#888888] dark:text-[#a3a3a3] font-mono">
          <div class="flex items-center gap-2">
            <img src="/favicon.svg" alt="PDFAfy Logo" class="w-6 h-6 rounded-md shadow-xs" />
            <span>{author}</span>
          </div>
          <span>•</span>
          <time datetime={pubDate.toISOString()}>
            {pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
          </time>
          <span>•</span>
          <span>{readTime}</span>
        </div>
      </header>

      <!-- Markdown Article Content -->
      <div class="prose prose-neutral dark:prose-invert max-w-none 
        prose-headings:font-semibold prose-headings:tracking-tight prose-headings:text-[#171717] dark:prose-headings:text-[#f5f5f5]
        prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4 prose-h2:border-b prose-h2:border-[#ebebeb] dark:prose-h2:border-[#262626] prose-h2:pb-2
        prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3
        prose-p:text-[#4d4d4d] dark:prose-p:text-[#a3a3a3] prose-p:leading-relaxed prose-p:mb-6
        prose-ul:my-6 prose-ul:list-disc prose-ul:pl-6 prose-li:text-[#4d4d4d] dark:prose-li:text-[#a3a3a3] prose-li:mb-2
        prose-table:w-full prose-table:my-8 prose-table:border-collapse
        prose-th:border prose-th:border-[#ebebeb] dark:prose-th:border-[#262626] prose-th:bg-[#fafafa] dark:prose-th:bg-[#121212] prose-th:p-3 prose-th:text-left prose-th:font-medium prose-th:text-[#171717] dark:prose-th:text-[#f5f5f5]
        prose-td:border prose-td:border-[#ebebeb] dark:prose-td:border-[#262626] prose-td:p-3 prose-td:text-[#4d4d4d] dark:prose-td:text-[#a3a3a3]
        prose-strong:text-[#171717] dark:prose-strong:text-[#f5f5f5] prose-strong:font-semibold
        prose-code:font-mono prose-code:text-xs prose-code:bg-[#fafafa] dark:prose-code:bg-[#171717] prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:border prose-code:border-[#ebebeb] dark:prose-code:border-[#262626]">
        <slot />
      </div>

      <!-- CTA Box inside article -->
      <div class="mt-16 p-8 rounded-2xl bg-[#fafafa] dark:bg-[#121212] border border-[#ebebeb] dark:border-[#262626] text-center relative overflow-hidden">
        <div class="absolute -top-24 -right-24 w-60 h-60 bg-gradient-to-br from-[#0070f3]/10 to-[#50e3c2]/10 rounded-full blur-3xl pointer-events-none"></div>
        <h3 class="text-xl font-semibold text-[#171717] dark:text-[#f5f5f5] mb-2">Need to convert a PDF right now?</h3>
        <p class="text-sm text-[#4d4d4d] dark:text-[#a3a3a3] max-w-md mx-auto mb-6">
          Convert your PDF into an ISO-compliant PDF/A-1b, PDF/A-2b, or PDF/A-3b document in seconds. 100% free and secure.
        </p>
        <a href="/" class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-[#171717] dark:bg-[#f5f5f5] text-white dark:text-[#0a0a0a] text-sm font-medium hover:bg-[#333333] dark:hover:bg-[#e5e5e5] transition-colors shadow-sm">
          Upload & Convert PDF
        </a>
      </div>
    </article>
  </div>
</BaseLayout>
