---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { generateBreadcrumbSchema } from '../utils/seo';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  author: string;
  readTime: string;
  tags: string[];
}

const { title, description, pubDate, author, readTime, tags } = Astro.props;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blog' },
  { name: title, url: Astro.url.pathname },
];

const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbs);
---

<BaseLayout title={`${title} | PDFAfy`} description={description} jsonLd={breadcrumbSchema}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20">
    <Breadcrumbs items={breadcrumbs} />
    
    <article class="mt-8">
      <!-- Article Header -->
      <header class="mb-14 pb-10 border-b border-[#ebebeb] dark:border-[#262626]">
        <div class="flex flex-wrap items-center gap-2 mb-6">
          {tags.map((tag) => (
            <span class="px-3 py-1 text-xs font-mono font-medium rounded-full bg-[#fafafa] dark:bg-[#171717] border border-[#ebebeb] dark:border-[#262626] text-[#4d4d4d] dark:text-[#a3a3a3]">
              {tag}
            </span>
          ))}
        </div>
        
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-[#171717] dark:text-[#f5f5f5] leading-[1.15] mb-6">
          {title}
        </h1>

        <p class="text-lg sm:text-xl text-[#4d4d4d] dark:text-[#a3a3a3] leading-relaxed mb-8 font-normal">
          {description}
        </p>

        <div class="flex flex-wrap items-center gap-4 text-xs sm:text-sm text-[#888888] dark:text-[#a3a3a3] font-mono pt-4 border-t border-[#ebebeb]/60 dark:border-[#262626]/60">
          <div class="flex items-center gap-2">
            <img src="/favicon.svg" alt="PDFAfy Logo" class="w-6 h-6 rounded-md shadow-xs" />
            <span class="text-[#171717] dark:text-[#f5f5f5] font-medium">{author}</span>
          </div>
          <span>•</span>
          <time datetime={pubDate.toISOString()}>
            {pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
          </time>
          <span>•</span>
          <span>{readTime}</span>
        </div>
      </header>

      <!-- Markdown Article Content: Highly Distinct Headings & Spacious Typography -->
      <div class="prose prose-lg dark:prose-invert max-w-none 
        prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-[#000000] dark:prose-headings:text-[#ffffff]
        prose-h2:text-2xl sm:prose-h2:text-3xl prose-h2:mt-16 prose-h2:mb-6 prose-h2:pt-4 prose-h2:border-t prose-h2:border-[#ebebeb] dark:prose-h2:border-[#262626] prose-h2:font-extrabold prose-h2:text-[#0a0a0a] dark:prose-h2:text-[#ffffff]
        prose-h3:text-xl sm:prose-h3:text-2xl prose-h3:mt-10 prose-h3:mb-4 prose-h3:font-bold prose-h3:text-[#171717] dark:prose-h3:text-[#f5f5f5]
        prose-p:text-base sm:prose-p:text-lg prose-p:text-[#4b5563] dark:prose-p:text-[#a3a3a3] prose-p:leading-[1.85] prose-p:mb-8 prose-p:font-normal
        prose-ul:my-8 prose-ul:list-disc prose-ul:pl-6 prose-ul:space-y-3 prose-li:text-base sm:prose-li:text-lg prose-li:text-[#4b5563] dark:prose-li:text-[#a3a3a3] prose-li:leading-[1.75]
        prose-ol:my-8 prose-ol:list-decimal prose-ol:pl-6 prose-ol:space-y-3 prose-ol:text-[#4b5563] dark:prose-ol:text-[#a3a3a3]
        prose-blockquote:my-8 prose-blockquote:border-l-4 prose-blockquote:border-[#0070f3] prose-blockquote:bg-[#fafafa] dark:prose-blockquote:bg-[#121212] prose-blockquote:p-6 prose-blockquote:rounded-r-2xl prose-blockquote:not-italic prose-blockquote:text-[#171717] dark:prose-blockquote:text-[#f5f5f5] prose-blockquote:font-medium
        prose-table:w-full prose-table:my-10 prose-table:border-collapse prose-table:rounded-xl prose-table:overflow-hidden
        prose-th:border prose-th:border-[#ebebeb] dark:prose-th:border-[#262626] prose-th:bg-[#fafafa] dark:prose-th:bg-[#171717] prose-th:p-4 prose-th:text-left prose-th:font-semibold prose-th:text-[#171717] dark:prose-th:text-[#f5f5f5] prose-th:text-xs prose-th:font-mono prose-th:uppercase
        prose-td:border prose-td:border-[#ebebeb] dark:prose-td:border-[#262626] prose-td:p-4 prose-td:text-sm prose-td:text-[#4d4d4d] dark:prose-td:text-[#a3a3a3]
        prose-strong:text-[#171717] dark:prose-strong:text-[#ffffff] prose-strong:font-bold
        prose-hr:my-12 prose-hr:border-[#ebebeb] dark:prose-hr:border-[#262626]
        prose-code:font-mono prose-code:text-xs sm:prose-code:text-sm prose-code:bg-[#fafafa] dark:prose-code:bg-[#171717] prose-code:px-2 prose-code:py-1 prose-code:rounded-md prose-code:border prose-code:border-[#ebebeb] dark:prose-code:border-[#262626]">
        <slot />
      </div>

      <!-- CTA Box inside article -->
      <div class="mt-20 p-8 sm:p-10 rounded-3xl bg-[#fafafa] dark:bg-[#121212] border border-[#ebebeb] dark:border-[#262626] text-center relative overflow-hidden shadow-xs space-y-4">
        <div class="absolute -top-24 -right-24 w-60 h-60 bg-gradient-to-br from-[#0070f3]/10 to-[#50e3c2]/10 rounded-full blur-3xl pointer-events-none"></div>
        <h3 class="text-2xl font-semibold text-[#171717] dark:text-[#f5f5f5]">Need to convert a PDF to PDF/A right now?</h3>
        <p class="text-sm sm:text-base text-[#4d4d4d] dark:text-[#a3a3a3] max-w-lg mx-auto leading-relaxed">
          Convert your PDF into an ISO 19005-compliant PDF/A-1b, PDF/A-2b, or PDF/A-3b document in seconds. 100% free and client-side secure.
        </p>
        <div class="pt-2">
          <a href="/#upload-zone" class="inline-flex items-center justify-center px-8 py-3 rounded-full bg-[#171717] dark:bg-[#f5f5f5] text-white dark:text-[#0a0a0a] text-sm font-semibold hover:bg-[#333333] dark:hover:bg-[#e5e5e5] transition-colors shadow-sm">
            Upload & Convert PDF
          </a>
        </div>
      </div>
    </article>
  </div>
</BaseLayout>
