---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { generateBreadcrumbSchema } from '../utils/seo';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Privacy Policy', url: '/privacy' },
];

const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbs);
---

<BaseLayout
  title="Privacy Policy & Security Guarantee — PDFAfy"
  description="PDFAfy Privacy Policy: Learn how our client-side architecture guarantees zero server storage and complete document confidentiality."
  jsonLd={breadcrumbSchema}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 space-y-8">
    <Breadcrumbs items={breadcrumbs} />

    <header class="space-y-3 pb-6 border-b border-[#ebebeb] dark:border-[#262626]">
      <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight text-[#171717] dark:text-[#f5f5f5]">
        Privacy Policy & Security Pledge
      </h1>
      <p class="text-xs font-mono text-[#888888] dark:text-[#a3a3a3]">Last Updated: August 2026</p>
    </header>

    <div class="space-y-6 text-sm text-[#4d4d4d] dark:text-[#a3a3a3] leading-relaxed">
      <section class="space-y-2">
        <h2 class="text-lg font-semibold text-[#171717] dark:text-[#f5f5f5]">1. Client-Side Browser Architecture</h2>
        <p>
          At PDFAfy, data privacy is not an afterthought—it is built into our core codebase. Unlike conventional online file converters that upload your confidential PDF files to external cloud servers or databases, PDFAfy executes PDF to PDF/A transformations directly inside your web browser session using modern client-side standards.
        </p>
      </section>

      <section class="space-y-2">
        <h2 class="text-lg font-semibold text-[#171717] dark:text-[#f5f5f5]">2. Zero Server Storage Guarantee</h2>
        <p>
          Your document content, text streams, embedded images, and metadata are parsed in local volatile memory during the conversion process. We do not store, log, transmit, or retain any user documents on any server or third-party storage infrastructure.
        </p>
      </section>

      <section class="space-y-2">
        <h2 class="text-lg font-semibold text-[#171717] dark:text-[#f5f5f5]">3. Data Retention & Automatic Memory Clearance</h2>
        <p>
          Once your converted PDF/A file is generated and downloaded, or as soon as you navigate away from or refresh the page, all associated memory buffers are immediately purged by the browser runtime engine.
        </p>
      </section>

      <section class="space-y-2">
        <h2 class="text-lg font-semibold text-[#171717] dark:text-[#f5f5f5]">4. Analytics & Cookies</h2>
        <p>
          PDFAfy uses zero tracking cookies or invasive third-party cross-site trackers. We respect user privacy preferences and do not monetize or profile user activity.
        </p>
      </section>
    </div>
  </div>
</BaseLayout>
