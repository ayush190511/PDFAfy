---
const securityPillars = [
  {
    title: 'Client-Side Execution',
    description: 'Document bytes are parsed and converted locally in your browser memory space using WebAssembly & JS standards.',
  },
  {
    title: 'Zero Server Storage',
    description: 'We do not maintain permanent databases or cloud buckets storing user uploaded documents. Ever.',
  },
  {
    title: 'Automatic Session Clearance',
    description: 'As soon as you close the tab or convert another file, temporary browser memory buffers are cleared instantly.',
  },
  {
    title: 'End-to-End HTTPS Encryption',
    description: 'All web traffic and asset deliveries are protected with TLS 1.3 encryption and Strict Content Security Policies.',
  },
];
---

<section class="py-20 sm:py-28 lg:py-32 bg-white dark:bg-[#0a0a0a] border-b border-[#ebebeb] dark:border-[#262626] transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto rounded-3xl bg-[#fafafa] dark:bg-[#121212] border border-[#ebebeb] dark:border-[#262626] p-8 sm:p-14 relative overflow-hidden shadow-xs">
      <!-- Glow decoration -->
      <div class="absolute top-0 right-0 w-80 h-80 bg-gradient-to-br from-[#50e3c2]/10 to-[#0070f3]/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 space-y-10">
        <div class="space-y-4">
          <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white dark:bg-[#171717] border border-[#ebebeb] dark:border-[#262626] text-xs font-mono text-[#171717] dark:text-[#f5f5f5]">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span>Security & Privacy Architecture</span>
          </div>

          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-semibold tracking-tight text-[#171717] dark:text-[#f5f5f5]">
            Your Files Stay Private. Guaranteed.
          </h2>

          <p class="text-base text-[#4d4d4d] dark:text-[#a3a3a3] max-w-2xl leading-relaxed">
            PDFAfy is engineered from the ground up for strict data privacy. We believe confidential legal documents, medical files, and financial records should never be saved on third-party servers.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-2">
          {securityPillars.map((pillar, idx) => (
            <div class="p-6 rounded-2xl bg-white dark:bg-[#171717] border border-[#ebebeb] dark:border-[#262626] space-y-2.5">
              <div class="flex items-center gap-3">
                <span class="w-6 h-6 rounded-full bg-[#171717] dark:bg-[#f5f5f5] text-white dark:text-[#0a0a0a] flex items-center justify-center font-mono text-xs font-semibold">
                  {idx + 1}
                </span>
                <h3 class="font-semibold text-base text-[#171717] dark:text-[#f5f5f5]">{pillar.title}</h3>
              </div>
              <p class="text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a3a3a3] leading-relaxed pl-9">
                {pillar.description}
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
