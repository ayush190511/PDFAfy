---
import { UploadZone } from './UploadZone';
---

<section class="relative overflow-hidden pt-16 pb-20 sm:pt-24 sm:pb-32 border-b border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#0a0a0a] transition-colors">
  <!-- Mesh Gradient Background Glow -->
  <div class="absolute inset-0 mesh-gradient-bg pointer-events-none opacity-60 dark:opacity-80"></div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-12">
    <!-- Hero Header Text -->
    <div class="text-center max-w-3xl mx-auto space-y-6">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#fafafa] dark:bg-[#171717] border border-[#ebebeb] dark:border-[#262626] text-xs font-mono text-[#4d4d4d] dark:text-[#a3a3a3]">
        <span class="w-2 h-2 rounded-full bg-[#0070f3]"></span>
        <span>ISO 19005-1 / 19005-2 / 19005-3 Archival Engine</span>
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-semibold tracking-tight text-[#171717] dark:text-[#f5f5f5] leading-[1.1]">
        Convert PDF to PDF/A Online
      </h1>

      <p class="text-base sm:text-lg text-[#4d4d4d] dark:text-[#a3a3a3] max-w-2xl mx-auto leading-relaxed">
        Convert your PDF into ISO-compliant PDF/A documents in seconds. Secure, fast, and free.
      </p>

      <div class="flex items-center justify-center gap-4 pt-2">
        <a
          href="#upload-zone"
          class="px-7 py-3 rounded-full bg-[#171717] dark:bg-[#f5f5f5] text-white dark:text-[#0a0a0a] text-xs sm:text-sm font-medium hover:bg-[#333333] dark:hover:bg-[#e5e5e5] transition-all shadow-xs"
        >
          Upload PDF
        </a>
        <a
          href="/about-pdfa"
          class="px-7 py-3 rounded-full bg-[#fafafa] dark:bg-[#171717] border border-[#ebebeb] dark:border-[#262626] text-[#171717] dark:text-[#f5f5f5] text-xs sm:text-sm font-medium hover:bg-[#f5f5f5] dark:hover:bg-[#262626] transition-colors"
        >
          Learn about PDF/A
        </a>
      </div>
    </div>

    <!-- Above The Fold Converter Island -->
    <div class="pt-4">
      <UploadZone client:load />
    </div>
  </div>
</section>
