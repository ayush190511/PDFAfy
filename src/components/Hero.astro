---
import { UploadZone } from './UploadZone';
---

<section class="relative overflow-hidden pt-12 pb-16 sm:pt-20 sm:pb-24 border-b border-[#ebebeb] bg-white">
  <!-- Mesh Gradient Background Glow -->
  <div class="absolute inset-0 mesh-gradient-bg pointer-events-none opacity-60"></div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Hero Header Text -->
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#fafafa] border border-[#ebebeb] text-xs font-mono text-[#4d4d4d]">
        <span class="w-2 h-2 rounded-full bg-[#0070f3]"></span>
        <span>ISO 19005-1 / 19005-2 / 19005-3 Archival Engine</span>
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-semibold tracking-tight text-[#171717] leading-[1.1]">
        Convert PDF to PDF/A Online
      </h1>

      <p class="text-base sm:text-lg text-[#4d4d4d] max-w-2xl mx-auto leading-relaxed">
        Convert your PDF into ISO-compliant PDF/A documents in seconds. Secure, fast, and free.
      </p>

      <div class="flex items-center justify-center gap-3 pt-2">
        <a
          href="#upload-zone"
          class="px-6 py-2.5 rounded-full bg-[#171717] text-white text-xs sm:text-sm font-medium hover:bg-[#333333] transition-all shadow-xs"
        >
          Upload PDF
        </a>
        <a
          href="/about-pdfa"
          class="px-6 py-2.5 rounded-full bg-[#fafafa] border border-[#ebebeb] text-[#171717] text-xs sm:text-sm font-medium hover:bg-[#f5f5f5] transition-colors"
        >
          Learn about PDF/A
        </a>
      </div>
    </div>

    <!-- Above The Fold Converter Island -->
    <UploadZone client:load />
  </div>
</section>
