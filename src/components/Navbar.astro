---
const currentPath = Astro.url.pathname;

const navLinks = [
  { name: 'Convert', href: '/' },
  { name: 'About PDF/A', href: '/about-pdfa' },
  { name: 'FAQ', href: '/faq' },
  { name: 'Blog', href: '/blog' },
];
---

<header class="sticky top-0 z-50 w-full border-b border-[#ebebeb] bg-white/80 backdrop-blur-md transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="w-8 h-8 rounded-lg bg-[#171717] text-white flex items-center justify-center font-mono font-semibold text-xs tracking-tighter shadow-sm group-hover:scale-105 transition-transform">
        A
      </div>
      <div class="flex items-baseline gap-1">
        <span class="font-semibold text-base tracking-tight text-[#171717]">PDFAfy</span>
        <span class="text-[10px] font-mono font-medium px-1.5 py-0.5 rounded bg-[#fafafa] border border-[#ebebeb] text-[#888888]">ISO 19005</span>
      </div>
    </a>

    <!-- Nav Links (Desktop) -->
    <nav class="hidden md:flex items-center gap-1">
      {navLinks.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return (
          <a
            href={link.href}
            class={`px-3 py-1.5 text-sm font-medium rounded-full transition-colors ${
              isActive
                ? 'text-[#171717] bg-[#f5f5f5]'
                : 'text-[#4d4d4d] hover:text-[#171717] hover:bg-[#fafafa]'
            }`}
          >
            {link.name}
          </a>
        );
      })}
    </nav>

    <!-- Header Actions -->
    <div class="flex items-center gap-3">
      <div class="hidden sm:flex items-center gap-1.5 text-xs text-[#4d4d4d] bg-[#fafafa] border border-[#ebebeb] px-2.5 py-1 rounded-full font-mono">
        <span class="w-2 h-2 rounded-full bg-[#50e3c2] animate-pulse"></span>
        <span>100% Client-Side Private</span>
      </div>
      
      <a
        href="/"
        class="inline-flex items-center justify-center text-xs font-medium px-4 py-2 rounded-full bg-[#171717] text-white hover:bg-[#333333] transition-colors shadow-xs"
      >
        Convert PDF
      </a>
    </div>
  </div>
</header>
